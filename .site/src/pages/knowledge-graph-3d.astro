---
// Standalone 3D knowledge graph page. It does not load the Starlight theme, so it
// imports the restack tokens directly; the page is always the dark face.
import '../styles/restack/fonts.css';
import '../styles/restack/color.css';
import '../styles/restack/typography.css';
import '../styles/restack/space.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>3D Knowledge Graph - AI Data Center Systems</title>
    <link rel="icon" href="/favicon.svg" />
    <meta
      name="description"
      content="Interactive 3D knowledge graph for AI Data Center Systems."
    />
    <style is:global>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      :root {
        --bg: var(--restack-color-canvas);
        --panel: color-mix(in srgb, var(--restack-color-surface) 88%, transparent);
        --panel-strong: color-mix(in srgb, var(--restack-color-surface) 97%, transparent);
        --line: var(--restack-color-border);
        --text: var(--restack-color-text);
        --muted: var(--restack-color-text-muted);
        --soft: var(--restack-color-text-secondary);
        /* Lime marks what is active or selected; it is the only interaction colour. */
        --cyan: var(--restack-color-primary-strong);
        --blue: var(--restack-color-accent);
        --violet: var(--restack-color-viz-4);
        --red: var(--restack-color-danger);
        --green: var(--restack-color-success);
        --amber: var(--restack-color-warning);
        --radius: var(--restack-radius-md);
        --font: var(--restack-font-family-sans);
      }

      html,
      body {
        width: 100%;
        min-height: 100%;
        margin: 0;
        overflow: hidden;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font);
        letter-spacing: 0;
      }

      body {
        min-height: 100dvh;
      }

      button,
      input,
      select {
        font: inherit;
      }

      a {
        color: inherit;
      }

      .graph3d {
        position: fixed;
        inset: 0;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        background: var(--bg);
      }

      #graph-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
      }

      .topbar {
        position: relative;
        z-index: 5;
        display: grid;
        grid-template-columns: minmax(14rem, 1fr) minmax(20rem, 40rem) auto;
        gap: 0.75rem;
        align-items: center;
        border-bottom: 1px solid var(--line);
        padding: 0.75rem max(1rem, env(safe-area-inset-right)) 0.75rem max(1rem, env(safe-area-inset-left));
        background: var(--restack-color-surface-sunken);
        backdrop-filter: blur(14px);
      }

      .brand {
        display: grid;
        min-width: 0;
        gap: 0.08rem;
        text-decoration: none;
      }

      .brand span {
        color: var(--muted);
        font-family: var(--restack-font-family-mono);
        font-size: var(--restack-font-size-micro);
        font-weight: var(--restack-font-weight-medium);
        letter-spacing: var(--restack-letter-spacing-caps);
        text-transform: uppercase;
      }

      .brand h1 {
        margin: 0;
        overflow: hidden;
        color: var(--restack-color-text-strong);
        font-size: 1.05rem;
        font-weight: var(--restack-font-weight-semibold);
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
      }

      .search-row {
        display: flex;
        gap: 0.45rem;
        min-width: 0;
      }

      .search-box {
        position: relative;
        flex: 1;
        min-width: 0;
      }

      .search-results {
        position: absolute;
        z-index: 8;
        top: calc(100% + 0.35rem);
        left: 0;
        right: 0;
        display: grid;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.25rem;
        background: var(--panel-strong);
        backdrop-filter: blur(14px);
      }

      .search-results[hidden] {
        display: none;
      }

      .search-results button,
      .search-results span {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 0;
        border-radius: 6px;
        padding: 0.45rem 0.55rem;
        color: var(--soft);
        background: transparent;
        font-size: 0.82rem;
        text-align: left;
      }

      .search-results button {
        cursor: pointer;
      }

      .search-results button:hover,
      .search-results button:first-child {
        color: var(--text);
        background: var(--restack-color-surface-hover);
      }

      .search-results small {
        margin-left: auto;
        color: var(--muted);
        font-size: 0.7rem;
        white-space: nowrap;
      }

      .search-results span {
        color: var(--muted);
      }

      .dot {
        flex: none;
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 999px;
      }

      .dot[data-kind="concept"] {
        border-radius: 2px;
      }

      .search {
        display: flex;
        min-width: 0;
        border: 1px solid var(--restack-color-border-strong);
        border-radius: var(--radius);
        background: var(--restack-color-surface-sunken);
      }

      .search input {
        width: 100%;
        min-height: 2.35rem;
        min-width: 0;
        border: 0;
        padding: 0 0.8rem;
        color: var(--text);
        background: transparent;
        outline: none;
      }

      .search input::placeholder {
        color: var(--restack-color-text-subtle);
      }

      .controls {
        display: flex;
        align-items: center;
        justify-content: end;
        gap: 0.45rem;
      }

      .icon-button,
      .select {
        min-height: 2.35rem;
        border: 1px solid var(--restack-color-border-strong);
        border-radius: var(--radius);
        color: var(--text);
        background: var(--restack-color-surface-sunken);
      }

      .icon-button {
        display: inline-grid;
        place-items: center;
        width: 2.35rem;
        padding: 0;
        cursor: pointer;
      }

      .icon-button svg {
        width: 1rem;
        height: 1rem;
        stroke: currentColor;
        stroke-width: 2;
        fill: none;
      }

      .icon-button[data-active="true"] {
        border-color: var(--restack-color-primary-subtle);
        color: var(--cyan);
        background: var(--restack-color-primary-surface);
      }

      .icon-button:disabled {
        cursor: default;
        opacity: 0.42;
      }

      .select {
        width: 8.5rem;
        padding: 0 0.65rem;
      }

      .stage {
        position: relative;
        min-height: 0;
      }

      .hud {
        position: absolute;
        z-index: 4;
        left: max(1rem, env(safe-area-inset-left));
        bottom: max(1rem, env(safe-area-inset-bottom));
        display: grid;
        gap: 0.5rem;
        max-width: min(62rem, calc(100vw - 27rem));
      }

      .hud-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
      }

      .track {
        cursor: pointer;
      }

      .track b {
        color: var(--muted);
        font-weight: 600;
      }

      .track[aria-pressed="true"] {
        border-color: currentColor;
        color: var(--text);
      }

      .hud-row[data-filtered="true"] .track[aria-pressed="false"] {
        opacity: 0.45;
      }

      .metric-button {
        cursor: pointer;
      }

      .metric-button[aria-pressed="true"] {
        border-color: var(--restack-color-primary-subtle);
        color: var(--cyan);
      }

      .metric,
      .legend {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2rem;
        border: 1px solid var(--line);
        border-radius: 999px;
        padding: 0.35rem 0.65rem;
        color: var(--soft);
        background: var(--panel);
        font-size: 0.76rem;
        backdrop-filter: blur(12px);
      }

      .legend i {
        width: 0.65rem;
        height: 0.65rem;
        border-radius: 999px;
      }

      .legend .doc {
        background: var(--soft);
      }

      .legend .concept {
        border-radius: 2px;
        background: var(--soft);
      }

      .legend .selected {
        border: 2px solid var(--restack-color-primary-strong);
        background: transparent;
      }

      .details {
        position: absolute;
        z-index: 4;
        top: 1rem;
        right: max(1rem, env(safe-area-inset-right));
        display: grid;
        gap: 0.8rem;
        width: min(24rem, calc(100vw - 2rem));
        max-height: calc(100% - 2rem);
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 0.95rem;
        background: var(--panel);
        backdrop-filter: blur(14px);
      }

      .details-head {
        display: flex;
        align-items: start;
        justify-content: space-between;
        gap: 0.75rem;
      }

      .details-close {
        display: inline-grid;
        flex: none;
        place-items: center;
        width: 1.75rem;
        height: 1.75rem;
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 0;
        color: var(--soft);
        background: transparent;
        cursor: pointer;
      }

      .details-close[hidden] {
        display: none;
      }

      .details-close svg {
        width: 0.9rem;
        height: 0.9rem;
        stroke: currentColor;
        stroke-width: 2;
        stroke-linecap: round;
        fill: none;
      }

      .details h2 {
        margin: 0;
        color: var(--text);
        font-size: 1.05rem;
        line-height: 1.25;
      }

      .details p {
        margin: 0;
        color: var(--muted);
        font-size: 0.84rem;
        line-height: 1.45;
      }

      .detail-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
      }

      .detail-meta span,
      .neighbor-list button {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        border: 1px solid var(--restack-color-border);
        border-radius: 999px;
        padding: 0.28rem 0.5rem;
        color: var(--soft);
        background: var(--restack-color-surface-raised);
        font-size: 0.72rem;
      }

      .neighbor-list button {
        cursor: pointer;
      }

      .neighbor-list button:hover {
        border-color: var(--restack-color-primary-subtle);
        color: var(--text);
      }

      .neighbor-list .more {
        border-style: dashed;
        color: var(--muted);
      }

      .open-link {
        display: none;
        justify-content: center;
        min-height: 2.35rem;
        border: 1px solid var(--restack-color-primary-edge);
        border-radius: var(--radius);
        padding: 0.55rem 0.75rem;
        color: var(--restack-color-on-primary);
        background: var(--restack-color-primary);
        font-size: 0.82rem;
        font-weight: var(--restack-font-weight-semibold);
        text-decoration: none;
      }

      .open-link[data-visible="true"] {
        display: inline-flex;
      }

      .neighbor-list {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
      }

      .status {
        position: absolute;
        z-index: 6;
        inset: 0;
        display: grid;
        place-items: center;
        padding: 1rem;
        color: var(--soft);
        background: color-mix(in srgb, var(--restack-color-canvas) 62%, transparent);
      }

      .status[hidden] {
        display: none;
      }

      .status-box {
        display: grid;
        gap: 0.35rem;
        max-width: 24rem;
        border: 1px solid var(--line);
        border-radius: var(--radius);
        padding: 1rem;
        background: var(--panel-strong);
        text-align: center;
      }

      .status-box strong {
        color: var(--text);
      }

      @media (max-width: 56rem) {
        .topbar {
          grid-template-columns: minmax(0, 1fr) auto;
          gap: 0.5rem;
          padding-block: 0.55rem;
        }

        .brand span {
          display: none;
        }

        .search-row {
          grid-column: 1 / -1;
          grid-row: 2;
        }

        .select {
          width: 7rem;
        }

        /* Legend sits under the top bar as one scrollable row. */
        .hud {
          top: 0.6rem;
          bottom: auto;
          right: 0;
          left: 0;
          max-width: none;
          gap: 0.4rem;
        }

        .hud-row {
          flex-wrap: nowrap;
          overflow-x: auto;
          padding-inline: 1rem;
          scrollbar-width: none;
        }

        .hud-row > * {
          flex: none;
        }

        .hud .hint {
          display: none;
        }

        /* Details become a bottom sheet that only appears for a selection. */
        .details {
          top: auto;
          right: 0;
          bottom: 0;
          left: 0;
          width: auto;
          max-height: 46%;
          border-width: 1px 0 0;
          border-radius: 14px 14px 0 0;
          padding-bottom: max(0.95rem, env(safe-area-inset-bottom));
          background: var(--panel-strong);
        }

        .details[data-open="false"] {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <main class="graph3d">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Back to AI Data Center Systems">
          <span>AI Data Center Systems</span>
          <h1>Full Knowledge Graph 3D</h1>
        </a>
        <div class="search-row">
          <div class="search-box">
            <label class="search" aria-label="Search nodes">
              <input
                id="search"
                type="search"
                placeholder="Search documents or concepts"
                autocomplete="off"
                aria-controls="search-results"
              />
            </label>
            <div class="search-results" id="search-results" hidden></div>
          </div>
          <select class="select" id="kind-filter" aria-label="Node kind filter">
            <option value="all">All nodes</option>
            <option value="doc">Documents</option>
            <option value="concept">Concepts</option>
          </select>
        </div>
        <div class="controls" aria-label="Graph controls">
          <button class="icon-button" id="rotate" type="button" data-active="true" aria-label="Toggle rotation">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M21 12a9 9 0 0 1-15.4 6.4" />
              <path d="M3 12A9 9 0 0 1 18.4 5.6" />
              <path d="M18 2v4h4" />
              <path d="M6 22v-4H2" />
            </svg>
          </button>
          <button class="icon-button" id="labels" type="button" data-active="true" aria-label="Toggle labels">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M4 6h16" />
              <path d="M4 12h10" />
              <path d="M4 18h7" />
            </svg>
          </button>
          <button class="icon-button" id="reset" type="button" aria-label="Reset camera">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 12a9 9 0 1 0 3-6.7" />
              <path d="M3 4v6h6" />
            </svg>
          </button>
          <button class="icon-button" id="bgm" type="button" data-active="false" aria-label="Loading background music" disabled>
            <svg id="bgm-icon" viewBox="0 0 24 24" aria-hidden="true">
              <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" />
              <line x1="17" y1="9" x2="23" y2="15" />
              <line x1="23" y1="9" x2="17" y2="15" />
            </svg>
          </button>
        </div>
      </header>

      <section class="stage" aria-label="3D knowledge graph">
        <canvas id="graph-canvas"></canvas>
        <aside class="details" id="details" aria-live="polite" data-open="false">
          <div class="details-head">
            <h2>Knowledge Graph</h2>
            <button class="details-close" id="details-close" type="button" aria-label="Clear selection" hidden>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
            </button>
          </div>
          <p id="detail-copy">Click a node to see what it connects to, or a track to isolate it.</p>
          <div class="detail-meta" id="detail-meta"></div>
          <a class="open-link" id="open-link" href="/">Open document</a>
          <div class="neighbor-list" id="neighbors"></div>
        </aside>
        <div class="hud" aria-label="Graph legend and metrics">
          <div class="hud-row" id="track-legend" role="group" aria-label="Tracks"></div>
          <div class="hud-row">
            <span class="metric" id="node-count">0 nodes</span>
            <button class="metric metric-button" id="edge-count" type="button" aria-pressed="false">0 links</button>
            <span class="legend"><i class="doc"></i>Document</span>
            <span class="legend"><i class="concept"></i>Concept</span>
            <span class="legend"><i class="selected"></i>Selected</span>
            <span class="metric hint">Zoom in to reveal more labels</span>
          </div>
        </div>
        <div class="status" id="status">
          <div class="status-box">
            <strong>Loading graph</strong>
            <span>Preparing the 3D layout.</span>
          </div>
        </div>
      </section>
    </main>
    <div id="yt-bgm-player" aria-hidden="true"></div>

    <script>
      import * as THREE from 'three';
      import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
      import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
      import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
      import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

      const canvas = document.querySelector('#graph-canvas');
      const status = document.querySelector('#status');
      const searchInput = document.querySelector('#search');
      const kindFilter = document.querySelector('#kind-filter');
      const searchResults = document.querySelector('#search-results');
      const trackLegend = document.querySelector('#track-legend');
      const details = document.querySelector('#details');
      const detailsClose = document.querySelector('#details-close');
      const rotateButton = document.querySelector('#rotate');
      const labelsButton = document.querySelector('#labels');
      const resetButton = document.querySelector('#reset');
      const nodeCount = document.querySelector('#node-count');
      const edgeCount = document.querySelector('#edge-count');
      const detailTitle = document.querySelector('#details h2');
      const detailCopy = document.querySelector('#detail-copy');
      const detailMeta = document.querySelector('#detail-meta');
      const openLink = document.querySelector('#open-link');
      const neighbors = document.querySelector('#neighbors');
      const bgmButton = document.querySelector('#bgm');
      const bgmIcon = document.querySelector('#bgm-icon');

      // When embedded (graph modal iframe), document links must swap the whole
      // page, not navigate inside the frame.
      if (window.self !== window.top) {
        const base = document.createElement('base');
        base.target = '_top';
        document.head.append(base);
      }

      let fatalShown = false;
      let bgmPlayer = null;
      let userHasInteracted = false;
      window.addEventListener('error', (event) => {
        if (!status.hidden && !fatalShown) showStatus('Viewer error', event.message || 'Unexpected error.');
      });
      window.addEventListener('unhandledrejection', (event) => {
        if (!status.hidden && !fatalShown)
          showStatus('Viewer error', String(event.reason?.message ?? event.reason ?? 'Unexpected error.'));
      });

      // Scene colours come from the restack tokens on :root, so the 3D view and its
      // HTML chrome share one palette. The fallbacks are the dark-face values.
      function token(name, fallback) {
        return getComputedStyle(document.documentElement).getPropertyValue(`--restack-color-${name}`).trim() || fallback;
      }

      // Reserve lime for selection; only the six largest tracks get data colours.
      const trackColors = [
        token('viz-2', '#70c5d0'),
        token('viz-3', '#e1ad7d'),
        token('viz-4', '#cf9be0'),
        token('viz-5', '#d8cf89'),
        token('viz-6', '#d89dbd'),
        token('viz-7', '#94aaa8'),
      ];
      // Other is the quietest series: a dark slate, far below sage in lightness.
      const otherTrackColor = token('gray-600', '#3a4052');
      const minTrackSize = 4;
      // Concepts are told apart by shape (a box), so they stay neutral.
      const conceptColor = token('text-secondary', '#b5bbca');
      const neighborPreview = 8;
      const inactiveOpacity = 0.08;
      const bgmVideoId = 'eo1gKGt6h9M';
      const bgmIconOn =
        '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><path d="M15.54 8.46a5 5 0 0 1 0 7.07" /><path d="M19.07 4.93a10 10 0 0 1 0 14.14" />';
      const bgmIconOff =
        '<polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" /><line x1="17" y1="9" x2="23" y2="15" /><line x1="23" y1="9" x2="17" y2="15" />';
      const state = {
        graph: null,
        nodes: [],
        edges: [],
        tracks: [],
        clusterLabels: [],
        nodeObjects: new Map(),
        labelObjects: new Map(),
        labelOrder: [],
        selected: null,
        neighborIds: new Set(),
        neighborList: [],
        neighborsExpanded: false,
        matches: [],
        rotate: true,
        showAllEdges: false,
        focusDistance: null,
        hovered: null,
        focusPoint: null,
        labelVisible: true,
        query: '',
        kind: 'all',
        group: 'all',
      };

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(token('canvas', '#0c0d12'));
      scene.fog = new THREE.FogExp2(new THREE.Color(token('canvas', '#0c0d12')), 0.0012);

      const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 2800);
      camera.position.set(0, 120, 760);

      // Narrow (portrait) viewports need more distance to fit the graph.
      function homeDistance() {
        return window.innerWidth < window.innerHeight ? 1150 : 760;
      }

      let renderer;
      try {
        renderer = new THREE.WebGLRenderer({ canvas, antialias: true, alpha: true });
      } catch (error) {
        fatalShown = true;
        showStatus(
          'WebGL unavailable',
          'The browser could not create a WebGL context, so the 3D view cannot start. Enable hardware acceleration in the browser settings (chrome://settings/system), check chrome://gpu, then fully restart the browser and reload this page.',
        );
        throw error;
      }
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.06;

      let composer = null;
      try {
        composer = new EffectComposer(renderer);
        composer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        composer.setSize(window.innerWidth, window.innerHeight);
        composer.addPass(new RenderPass(scene, camera));
        composer.addPass(
          new UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 0.22, 0.4, 0.5),
        );
      } catch {
        composer = null;
      }

      const controls = new OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.06;
      controls.rotateSpeed = 0.48;
      controls.zoomSpeed = 0.72;
      controls.autoRotate = true;
      controls.autoRotateSpeed = 0.55;

      const graphGroup = new THREE.Group();
      scene.add(graphGroup);

      const nodeGroup = new THREE.Group();
      const labelGroup = new THREE.Group();
      graphGroup.add(nodeGroup, labelGroup);

      const selectionRing = makeSelectionRing();
      graphGroup.add(selectionRing);

      const raycaster = new THREE.Raycaster();
      const pointer = new THREE.Vector2();
      const pointerDown = new THREE.Vector2();
      const cameraOffset = new THREE.Vector3();
      let pointerMoved = false;
      let pointerDirty = false;

      init();

      async function init() {
        bindEvents();
        addAmbientScene();
        setupBgm();
        resize();
        resetCamera();

        try {
          const response = await fetch('/kb/dcs-kb-graph.json', { headers: { accept: 'application/json' } });
          if (!response.ok) throw new Error(`Graph request failed: ${response.status}`);
          const graph = await response.json();
          loadGraph(graph);
          focusFromQuery();
          status.hidden = true;
          animate();
        } catch (error) {
          showStatus('Graph unavailable', error instanceof Error ? error.message : 'Could not load graph data.');
        }
      }

      function bindEvents() {
        window.addEventListener('resize', resize);
        renderer.domElement.addEventListener('pointerdown', (event) => {
          pointerMoved = false;
          pointerDown.set(event.clientX, event.clientY);
        });
        renderer.domElement.addEventListener('pointermove', (event) => {
          pointerMoved ||= pointerDown.distanceTo(new THREE.Vector2(event.clientX, event.clientY)) > 4;
          const rect = renderer.domElement.getBoundingClientRect();
          pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
          pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
          pointerDirty = true;
        });
        renderer.domElement.addEventListener('pointerleave', () => {
          setHovered(null);
        });
        renderer.domElement.addEventListener('click', onCanvasClick);
        // Dragging or zooming by hand cancels an in-flight camera move.
        controls.addEventListener('start', () => {
          state.focusPoint = null;
          state.focusDistance = null;
        });

        searchInput.addEventListener('input', () => {
          state.query = searchInput.value.trim().toLowerCase();
          applyFilters();
          renderSearchResults();
        });
        searchInput.addEventListener('focus', renderSearchResults);
        searchInput.addEventListener('keydown', (event) => {
          if (event.key === 'Enter' && state.matches.length) {
            event.preventDefault();
            pickSearchResult(state.matches[0]);
          }
        });
        searchInput.addEventListener('blur', () => {
          // Let a click on a result land before the list disappears.
          window.setTimeout(() => { searchResults.hidden = true; }, 150);
        });
        searchResults.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('button[data-id]') : null;
          const node = button && state.nodes.find((item) => item.id === button.dataset.id);
          if (node) pickSearchResult(node);
        });
        kindFilter.addEventListener('change', () => {
          state.kind = kindFilter.value;
          applyFilters();
          renderSearchResults();
        });
        trackLegend.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('button[data-track]') : null;
          if (!button) return;
          state.group = state.group === button.dataset.track ? 'all' : button.dataset.track;
          syncTrackLegend();
          applyFilters();
          frameTrack();
        });
        edgeCount.addEventListener('click', () => {
          state.showAllEdges = !state.showAllEdges;
          syncEdgeCount();
          applyFilters();
        });
        neighbors.addEventListener('click', (event) => {
          const button = event.target instanceof Element ? event.target.closest('button') : null;
          if (!button) return;
          if (button.dataset.more) {
            state.neighborsExpanded = true;
            renderNeighbors();
            return;
          }
          const node = state.nodes.find((item) => item.id === button.dataset.id);
          if (node) selectNode(node);
        });
        detailsClose.addEventListener('click', () => selectNode(null));
        window.addEventListener('keydown', (event) => {
          const typing = event.target instanceof HTMLElement && event.target.matches('input, select, textarea');
          if (event.key === 'Escape') {
            if (state.query) clearSearch();
            else if (state.selected) selectNode(null);
            searchInput.blur();
          } else if (event.key === '/' && !typing) {
            event.preventDefault();
            searchInput.focus();
          }
        });
        rotateButton.addEventListener('click', () => {
          state.rotate = !state.rotate;
          rotateButton.dataset.active = String(state.rotate);
          syncRotation();
        });
        labelsButton.addEventListener('click', () => {
          state.labelVisible = !state.labelVisible;
          labelsButton.dataset.active = String(state.labelVisible);
        });
        resetButton.addEventListener('click', resetCamera);
        bgmButton.addEventListener('click', () => {
          markInteracted();
          if (!bgmPlayer) return;
          if (bgmButton.dataset.active === 'true') {
            bgmPlayer.pauseVideo();
            setBgmUiState(false);
          } else {
            playBgmAudible();
          }
        });
        window.addEventListener('pointerdown', handleFirstInteraction);
        window.addEventListener('keydown', handleFirstInteraction);
      }

      function addAmbientScene() {
        scene.add(new THREE.AmbientLight(0xffffff, 1.45));

        const key = new THREE.DirectionalLight(0xffffff, 1.5);
        key.position.set(180, 280, 220);
        scene.add(key);

        // The signature indigo is atmosphere only: a soft fill from below.
        const fill = new THREE.DirectionalLight(new THREE.Color(token('signature', '#485cf9')), 0.8);
        fill.position.set(-240, -120, -180);
        scene.add(fill);

        const grid = new THREE.GridHelper(
          620,
          24,
          new THREE.Color(token('border', '#303545')),
          new THREE.Color(token('border-subtle', '#252935')),
        );
        grid.position.y = -170;
        grid.material.transparent = true;
        grid.material.opacity = 0.2;
        scene.add(grid);

        const starCount = 460;
        const starPositions = new Float32Array(starCount * 3);
        for (let i = 0; i < starCount; i += 1) {
          const radius = 520 + Math.random() * 480;
          const theta = Math.random() * Math.PI * 2;
          const y = (Math.random() * 2 - 1) * 0.9;
          const r = Math.sqrt(1 - y * y);
          starPositions[i * 3] = Math.cos(theta) * r * radius;
          starPositions[i * 3 + 1] = y * radius;
          starPositions[i * 3 + 2] = Math.sin(theta) * r * radius;
        }
        const starGeometry = new THREE.BufferGeometry();
        starGeometry.setAttribute('position', new THREE.BufferAttribute(starPositions, 3));
        const stars = new THREE.Points(
          starGeometry,
          new THREE.PointsMaterial({
            color: new THREE.Color(token('signature-strong', '#8595fa')),
            size: 1.5,
            sizeAttenuation: true,
            transparent: true,
            opacity: 0.38,
            depthWrite: false,
          }),
        );
        scene.add(stars);
      }

      // Browsers block unmuted autoplay, so the player starts muted and only
      // unmutes once the visitor interacts with the page in any way (click,
      // tap, key press) or with the speaker button directly.
      function setBgmUiState(audible) {
        bgmButton.dataset.active = String(audible);
        bgmButton.setAttribute('aria-label', audible ? 'Pause background music' : 'Play background music');
        bgmIcon.innerHTML = audible ? bgmIconOn : bgmIconOff;
      }

      function playBgmAudible() {
        if (!bgmPlayer) return;
        bgmPlayer.unMute();
        bgmPlayer.setVolume(40);
        bgmPlayer.playVideo();
        setBgmUiState(true);
      }

      function markInteracted() {
        if (userHasInteracted) return;
        userHasInteracted = true;
        window.removeEventListener('pointerdown', handleFirstInteraction);
        window.removeEventListener('keydown', handleFirstInteraction);
      }

      function handleFirstInteraction(event) {
        if (bgmButton.contains(event.target)) return;
        markInteracted();
        playBgmAudible();
      }

      function setupBgm() {
        const script = document.createElement('script');
        script.src = 'https://www.youtube.com/iframe_api';
        document.head.append(script);

        window.onYouTubeIframeAPIReady = () => {
          bgmPlayer = new window.YT.Player('yt-bgm-player', {
            width: '0',
            height: '0',
            videoId: bgmVideoId,
            // Looping a single video via the IFrame API requires pointing
            // `playlist` at its own id; `loop` alone is ignored otherwise.
            playerVars: {
              autoplay: 1,
              mute: 1,
              loop: 1,
              playlist: bgmVideoId,
              controls: 0,
              disablekb: 1,
              modestbranding: 1,
              playsinline: 1,
            },
            events: {
              onReady: (event) => {
                event.target.setVolume(40);
                bgmButton.disabled = false;
                if (userHasInteracted) playBgmAudible();
                else setBgmUiState(false);
              },
              onStateChange: (event) => {
                const State = window.YT.PlayerState;
                if (event.data === State.PLAYING || event.data === State.PAUSED) {
                  setBgmUiState(event.data === State.PLAYING && !bgmPlayer.isMuted());
                }
              },
              onError: () => {
                bgmButton.disabled = true;
                bgmButton.setAttribute('aria-label', 'Background music unavailable');
              },
            },
          });
        };

        window.setTimeout(() => {
          if (bgmButton.disabled) bgmButton.setAttribute('aria-label', 'Background music unavailable');
        }, 12000);
      }

      function loadGraph(graph) {
        state.graph = graph;
        state.nodes = graph.nodes.map((node, index) => ({ ...node, index }));
        const nodeByIndex = new Map(state.nodes.map((node, index) => [index, node]));
        const nodeById = new Map(state.nodes.map((node) => [node.id, node]));
        state.edges = graph.edges
          .map((edge) => {
            const source = typeof edge.s === 'number' ? nodeByIndex.get(edge.s) : nodeById.get(edge.source);
            const target = typeof edge.t === 'number' ? nodeByIndex.get(edge.t) : nodeById.get(edge.target);
            return {
              ...edge,
              source,
              target,
              type: edge.type ?? graph.edgeTypes?.[edge.k] ?? 'related',
              weight: edge.weight ?? edge.w ?? 0.2,
            };
          })
          .filter((edge) => edge.source && edge.target);

        assignTracks(state.nodes);
        markBackbone(state.nodes, state.edges);
        seedLayout(state.nodes, state.edges);
        renderEdges(state.edges.filter((edge) => edge.backbone), 'edges');
        renderEdges(state.edges.filter((edge) => !edge.backbone), 'edges-weak');
        renderNodes(state.nodes);
        renderLabels(state.nodes);
        renderClusterLabels();
        renderTrackLegend();
        nodeCount.textContent = `${state.nodes.length} nodes`;
        syncEdgeCount();
        applyFilters();
      }

      // Small tracks and tracks beyond the palette capacity share Other.
      function assignTracks(nodes) {
        const family = (node) => {
          const top = String(node.group || 'other').split('/')[0];
          return top === 'distributed-training' ? 'training' : top;
        };
        const counts = new Map();
        for (const node of nodes) counts.set(family(node), (counts.get(family(node)) || 0) + 1);

        const tracks = [...counts.entries()]
          .filter(([key, count]) => key !== 'other' && count >= minTrackSize)
          .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
          .slice(0, trackColors.length)
          .map(([key, count], index) => ({
            key,
            count,
            label: groupLabel(key),
            color: trackColors[index],
          }));
        const named = new Set(tracks.map((track) => track.key));
        const otherCount = nodes.filter((node) => !named.has(family(node))).length;
        if (otherCount) tracks.push({ key: 'other', count: otherCount, label: 'Other', color: otherTrackColor });

        const byKey = new Map(tracks.map((track) => [track.key, track]));
        for (const node of nodes) {
          node.track = named.has(family(node)) ? family(node) : 'other';
          node.color = byKey.get(node.track).color;
        }
        state.tracks = tracks;
      }

      // Only the backbone is drawn by default: every explicit link, plus each
      // node's two strongest edges so nothing floats free. The rest (mostly
      // shared-keyword edges) shows up for a selected node or on demand.
      function markBackbone(nodes, edges) {
        const strength = (edge) => edge.weight + (edge.type.includes('link') ? 1 : 0);
        const touching = new Map(nodes.map((node) => [node.id, []]));
        for (const edge of edges) {
          edge.backbone = edge.type.includes('link');
          touching.get(edge.source.id).push(edge);
          touching.get(edge.target.id).push(edge);
        }
        for (const list of touching.values()) {
          list.sort((a, b) => strength(b) - strength(a));
          for (const edge of list.slice(0, 2)) edge.backbone = true;
        }
      }

      function seedLayout(nodes, edges) {
        const clusters = state.tracks.filter((track) => track.key !== 'other');
        const home = new Map();
        clusters.forEach((track, index) => {
          const angle = (index / Math.max(clusters.length, 1)) * Math.PI * 2;
          home.set(track.key, {
            x: Math.cos(angle) * 250,
            y: (index % 2 === 0 ? 1 : -1) * 55,
            z: Math.sin(angle) * 250,
          });
        });

        for (const node of nodes) {
          // Concepts and small tracks start in the middle and settle between
          // the clusters that reference them.
          const anchor = (node.kind !== 'concept' && home.get(node.track)) || { x: 0, y: 0, z: 0 };
          const local = fibonacciPoint(node.index, nodes.length, node.kind === 'concept' ? 90 : 70);
          node.x = anchor.x + local.x;
          node.y = anchor.y + local.y;
          node.z = anchor.z + local.z;
          node.vx = 0;
          node.vy = 0;
          node.vz = 0;
        }

        const springs = edges.filter((edge) => edge.backbone || edge.type.includes('mentions'));
        for (let step = 0; step < 220; step += 1) {
          for (const node of nodes) {
            node.vx *= 0.7;
            node.vy *= 0.7;
            node.vz *= 0.7;
          }

          for (let i = 0; i < nodes.length; i += 1) {
            for (let j = i + 1; j < nodes.length; j += 1) {
              const a = nodes[i];
              const b = nodes[j];
              const dx = a.x - b.x;
              const dy = a.y - b.y;
              const dz = a.z - b.z;
              const distSq = Math.max(dx * dx + dy * dy + dz * dz, 120);
              const force = 2600 / distSq;
              a.vx += dx * force;
              a.vy += dy * force;
              a.vz += dz * force;
              b.vx -= dx * force;
              b.vy -= dy * force;
              b.vz -= dz * force;
            }
          }

          for (const edge of springs) {
            const a = edge.source;
            const b = edge.target;
            const mention = edge.type.includes('mentions');
            const sameTrack = a.track === b.track;
            const dx = b.x - a.x;
            const dy = b.y - a.y;
            const dz = b.z - a.z;
            const dist = Math.max(Math.sqrt(dx * dx + dy * dy + dz * dz), 1);
            const preferred = mention ? 120 : sameTrack ? 62 : 150;
            const force = (dist - preferred) * (mention ? 0.0007 : sameTrack ? 0.004 : 0.0007);
            const fx = (dx / dist) * force;
            const fy = (dy / dist) * force;
            const fz = (dz / dist) * force;
            a.vx += fx;
            a.vy += fy;
            a.vz += fz;
            b.vx -= fx;
            b.vy -= fy;
            b.vz -= fz;
          }

          for (const node of nodes) {
            const anchor = node.kind !== 'concept' && home.get(node.track);
            if (anchor) {
              node.vx += (anchor.x - node.x) * 0.022;
              node.vy += (anchor.y - node.y) * 0.022;
              node.vz += (anchor.z - node.z) * 0.022;
            } else {
              node.vx += -node.x * 0.012;
              node.vy += -node.y * 0.012;
              node.vz += -node.z * 0.012;
            }
            node.x += node.vx;
            node.y += node.vy;
            node.z += node.vz;
          }
        }

        normalizeLayout(nodes, 290);
      }

      function normalizeLayout(nodes, targetRadius) {
        const center = nodes.reduce(
          (acc, node) => {
            acc.x += node.x;
            acc.y += node.y;
            acc.z += node.z;
            return acc;
          },
          { x: 0, y: 0, z: 0 },
        );
        center.x /= Math.max(nodes.length, 1);
        center.y /= Math.max(nodes.length, 1);
        center.z /= Math.max(nodes.length, 1);

        const distances = [];
        for (const node of nodes) {
          node.x -= center.x;
          node.y -= center.y;
          node.z -= center.z;
          distances.push(Math.hypot(node.x, node.y, node.z));
        }

        // Scale by the 90th percentile, not the maximum: a few loosely linked
        // nodes drift far out and would otherwise shrink everything else.
        distances.sort((a, b) => a - b);
        const reference = Math.max(distances[Math.floor(distances.length * 0.9)] || 1, 1);
        const scale = targetRadius / reference;
        const limit = targetRadius * 1.2;
        for (const node of nodes) {
          node.x *= scale;
          node.y *= scale;
          node.z *= scale;
          const distance = Math.hypot(node.x, node.y, node.z);
          if (distance > limit) {
            node.x *= limit / distance;
            node.y *= limit / distance;
            node.z *= limit / distance;
          }
        }
      }

      function renderEdges(edges, name) {
        const positions = new Float32Array(edges.length * 6);
        const colors = new Float32Array(edges.length * 6);
        const color = new THREE.Color();

        edges.forEach((edge, index) => {
          const offset = index * 6;
          positions.set([edge.source.x, edge.source.y, edge.source.z, edge.target.x, edge.target.y, edge.target.z], offset);
          color.set(edgeColor(edge.type));
          const dim = 0.34 + Math.min(edge.weight, 1) * 0.42;
          colors.set([color.r * dim, color.g * dim, color.b * dim, color.r * dim, color.g * dim, color.b * dim], offset);
        });

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
        const material = new THREE.LineBasicMaterial({
          vertexColors: true,
          transparent: true,
          opacity: 0.42,
          depthWrite: false,
          blending: THREE.AdditiveBlending,
        });
        const lines = new THREE.LineSegments(geometry, material);
        lines.name = name;
        lines.userData.edges = edges;
        lines.userData.baseColors = colors.slice();
        graphGroup.add(lines);
      }

      function renderNodes(nodes) {
        const sphere = new THREE.SphereGeometry(1, 24, 16);
        const box = new THREE.BoxGeometry(1, 1, 1);

        for (const node of nodes) {
          const color = node.kind === 'concept' ? conceptColor : node.color;
          const material = new THREE.MeshStandardMaterial({
            color,
            emissive: color,
            emissiveIntensity: node.kind === 'concept' ? 0.5 : 0.34,
            roughness: 0.42,
            metalness: 0.14,
            transparent: true,
            opacity: 0.95,
          });
          const mesh = new THREE.Mesh(node.kind === 'concept' ? box : sphere, material);
          const radius = nodeRadius(node);
          mesh.scale.setScalar(radius);
          if (node.kind === 'concept') mesh.scale.y *= 0.72;
          mesh.position.set(node.x, node.y, node.z);
          mesh.userData.node = node;
          mesh.userData.baseScale = mesh.scale.clone();
          mesh.userData.baseEmissive = material.emissiveIntensity;
          nodeGroup.add(mesh);
          state.nodeObjects.set(node.id, mesh);
        }
      }

      // The selection marker is a ring around the node, so the node keeps its
      // track colour and the marker cannot be mistaken for one.
      function makeSelectionRing() {
        const size = 128;
        const ringCanvas = document.createElement('canvas');
        ringCanvas.width = size;
        ringCanvas.height = size;
        const context = ringCanvas.getContext('2d');
        context.beginPath();
        context.arc(size / 2, size / 2, size / 2 - 10, 0, Math.PI * 2);
        // A dark keyline separates the lime ring from bright nodes and links.
        context.strokeStyle = token('canvas', '#0c0d12');
        context.lineWidth = 15;
        context.stroke();
        context.strokeStyle = token('primary-strong', '#b2e879');
        context.lineWidth = 7;
        context.stroke();
        const texture = new THREE.CanvasTexture(ringCanvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        const ring = new THREE.Sprite(
          new THREE.SpriteMaterial({ map: texture, transparent: true, depthWrite: false, depthTest: false, toneMapped: false, fog: false }),
        );
        ring.renderOrder = 3;
        ring.visible = false;
        return ring;
      }

      // Labels reveal by camera distance, like map zoom levels: hub nodes are
      // always titled, mid nodes appear on approach, leaf nodes only up close.
      const labelTierDistance = [Infinity, 480, 300];
      const labelFadeRange = 70;
      const labelScreenHeight = 13;

      function renderLabels(nodes) {
        const ranked = [...nodes].sort(
          (a, b) => (b.weightedDegree || b.degree || 0) - (a.weightedDegree || a.degree || 0),
        );
        ranked.forEach((node, rank) => {
          node.labelTier = rank < 18 ? 0 : rank < 52 ? 1 : 2;
        });
        state.labelOrder = ranked.map((node) => node.id);

        for (const node of nodes) {
          const label = makeLabel(
            shortTitle(node.title),
            node.kind === 'concept' ? token('text-secondary', '#b5bbca') : token('text', '#e6e8ef'),
          );
          label.position.set(node.x, node.y + nodeRadius(node) + 7, node.z);
          label.userData.node = node;
          label.material.opacity = 0;
          label.visible = false;
          labelGroup.add(label);
          state.labelObjects.set(node.id, label);
        }
      }

      // One caption per track, floating above its cluster. They name the
      // clusters in the overview and fade out once the camera moves in.
      function renderClusterLabels() {
        for (const track of state.tracks) {
          if (track.key === 'other') continue;
          const members = state.nodes.filter((node) => node.track === track.key && node.kind !== 'concept');
          if (!members.length) continue;
          const sum = members.reduce(
            (acc, node) => ({ x: acc.x + node.x, y: acc.y + node.y, z: acc.z + node.z, top: Math.max(acc.top, node.y) }),
            { x: 0, y: 0, z: 0, top: -Infinity },
          );
          const centerY = sum.y / members.length;
          const label = makeLabel(track.label.toUpperCase(), track.color);
          label.position.set(sum.x / members.length, centerY + (sum.top - centerY) * 0.7 + 16, sum.z / members.length);
          label.material.opacity = 0;
          label.visible = false;
          labelGroup.add(label);
          state.clusterLabels.push({ label, track: track.key });
        }
      }

      function makeLabel(text, color) {
        const canvas = document.createElement('canvas');
        const context = canvas.getContext('2d');
        const fontSize = 30;
        const pad = 12;
        const font = `600 ${fontSize}px Inter, system-ui, sans-serif`;
        context.font = font;
        const width = Math.ceil(context.measureText(text).width) + pad * 2;
        const height = fontSize + pad * 2;
        canvas.width = width * 2;
        canvas.height = height * 2;
        context.scale(2, 2);
        context.font = font;
        context.textBaseline = 'middle';
        context.lineJoin = 'round';
        context.strokeStyle = token('canvas', '#0c0d12');
        context.lineWidth = 7;
        context.strokeText(text, pad, height / 2);
        context.fillStyle = color;
        context.fillText(text, pad, height / 2);

        const texture = new THREE.CanvasTexture(canvas);
        texture.colorSpace = THREE.SRGBColorSpace;
        const material = new THREE.SpriteMaterial({
          map: texture,
          transparent: true,
          depthWrite: false,
          depthTest: false,
          toneMapped: false,
        });
        const sprite = new THREE.Sprite(material);
        sprite.userData.aspect = width / height;
        sprite.renderOrder = 2;
        return sprite;
      }

      const labelProjection = new THREE.Vector3();

      function updateLabels() {
        const viewHeight = Math.max(renderer.domElement.clientHeight, 1);
        const viewWidth = Math.max(renderer.domElement.clientWidth, 1);
        const screenFactor = (2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2))) / viewHeight;
        const placed = [];

        // Fades a label toward `target`, hiding it instead when it would cover a
        // label that already claimed the space (unless `force` is set).
        const place = (label, target, heightPx, force) => {
          const dist = camera.position.distanceTo(label.position);
          if (target > 0) {
            labelProjection.copy(label.position).project(camera);
            if (labelProjection.z > 1) {
              target = 0;
            } else {
              const x = ((labelProjection.x + 1) / 2) * viewWidth;
              const y = ((1 - labelProjection.y) / 2) * viewHeight;
              const halfWidth = (heightPx * label.userData.aspect) / 2;
              const halfHeight = heightPx / 2 + 3;
              const rect = { x1: x - halfWidth, x2: x + halfWidth, y1: y - halfHeight, y2: y + halfHeight };
              const collides = placed.some(
                (other) => rect.x1 < other.x2 && rect.x2 > other.x1 && rect.y1 < other.y2 && rect.y2 > other.y1,
              );
              if (collides && !force) target = 0;
              else placed.push(rect);
            }
          }
          const opacity = label.material.opacity + (target - label.material.opacity) * 0.18;
          label.material.opacity = opacity;
          label.visible = opacity > 0.03;
          if (label.visible) {
            const worldHeight = dist * screenFactor * heightPx;
            label.scale.set(worldHeight * label.userData.aspect, worldHeight, 1);
          }
        };

        // Priority: the selection, the hovered node, the selection's neighbours
        // (strongest first), then everything else by importance.
        const order = [
          state.selected?.id,
          state.hovered?.id,
          ...state.neighborList.map((node) => node.id),
          ...(state.labelOrder || []),
        ];
        const seen = new Set();

        for (const id of order) {
          if (id == null || seen.has(id)) continue;
          seen.add(id);
          const label = state.labelObjects.get(id);
          if (!label) continue;
          const node = label.userData.node;
          const mesh = state.nodeObjects.get(id);
          const hovered = state.hovered?.id === id;
          const selected = state.selected?.id === id;
          const dist = camera.position.distanceTo(label.position);

          let target = 0;
          if (mesh?.visible && (state.labelVisible || hovered || selected)) {
            if (hovered || selected) {
              target = 1;
            } else if (state.selected) {
              // With a selection, name its neighbours regardless of zoom level.
              target = state.neighborIds.has(id) ? 1 : 0;
            } else {
              const limit = labelTierDistance[node.labelTier ?? 2];
              target = Math.min(1, (limit - dist) / labelFadeRange);
              target = Math.min(target, Math.max(0, (homeDistance() * 1.5 - dist) / 150));
              target = Math.max(target, 0);
            }
          }

          const heightPx = labelScreenHeight * (hovered || selected ? 1.3 : node.labelTier === 0 ? 1.08 : 1);
          place(label, target, heightPx, hovered || selected);
        }

        for (const { label, track } of state.clusterLabels) {
          const dist = camera.position.distanceTo(label.position);
          const shown =
            state.labelVisible && !state.selected && !state.query && (state.group === 'all' || state.group === track);
          const target = shown ? Math.min(0.9, Math.max(0, (dist - 300) / 120)) : 0;
          place(label, target, labelScreenHeight * 1.15, false);
        }
      }

      function matchesFilters(node) {
        const text = `${node.title} ${node.group || ''} ${node.description || ''}`.toLowerCase();
        return (
          (state.kind === 'all' || node.kind === state.kind) &&
          (state.group === 'all' || node.track === state.group) &&
          (!state.query || text.includes(state.query))
        );
      }

      function applyFilters() {
        const matchingIds = new Set();
        for (const node of state.nodes) {
          const visible = matchesFilters(node);
          const mesh = state.nodeObjects.get(node.id);
          if (mesh) {
            mesh.visible = visible;
            const emphasized =
              !state.selected || node.id === state.selected.id || state.neighborIds.has(node.id);
            mesh.material.opacity = visible ? (emphasized ? 0.95 : 0.05) : inactiveOpacity;
            mesh.material.depthWrite = emphasized;
            mesh.material.emissiveIntensity = emphasized ? mesh.userData.baseEmissive : 0.03;
          }
          if (visible) matchingIds.add(node.id);
        }

        // An edge is drawn only while both of its ends pass the filters. The
        // lines blend additively, so a black vertex colour hides the edge.
        for (const name of ['edges', 'edges-weak']) {
          const lines = graphGroup.getObjectByName(name);
          if (!lines) continue;
          const colors = lines.geometry.getAttribute('color');
          const base = lines.userData.baseColors;
          lines.userData.edges.forEach((edge, index) => {
            const shown = matchingIds.has(edge.source.id) && matchingIds.has(edge.target.id);
            for (let i = index * 6; i < index * 6 + 6; i += 1) colors.array[i] = shown ? base[i] : 0;
          });
          colors.needsUpdate = true;
        }
        const backbone = graphGroup.getObjectByName('edges');
        if (backbone) backbone.material.opacity = state.selected ? 0.07 : 0.5;
        const weak = graphGroup.getObjectByName('edges-weak');
        if (weak) {
          weak.visible = state.showAllEdges;
          weak.material.opacity = state.selected ? 0.04 : 0.26;
        }

        if (state.selected && !matchingIds.has(state.selected.id)) selectNode(null);
      }

      function renderTrackLegend() {
        trackLegend.innerHTML = state.tracks
          .map(
            (track) =>
              `<button class="legend track" type="button" data-track="${escapeHtml(track.key)}" aria-pressed="false"><i style="background:${track.color}"></i>${escapeHtml(track.label)} <b>${track.count}</b></button>`,
          )
          .join('');
      }

      // Centre the camera on the isolated track, or on the whole graph again.
      function frameTrack() {
        if (state.selected) return;
        const members = state.group === 'all' ? [] : state.nodes.filter((node) => node.track === state.group);
        const center = new THREE.Vector3();
        for (const node of members) center.add(new THREE.Vector3(node.x, node.y, node.z));
        if (members.length) center.divideScalar(members.length);
        const spread = Math.max(0, ...members.map((node) => center.distanceTo(new THREE.Vector3(node.x, node.y, node.z))));
        state.focusPoint = center;
        state.focusDistance = members.length ? THREE.MathUtils.clamp(spread * 2.6, 300, homeDistance()) : homeDistance();
      }

      function syncTrackLegend() {
        trackLegend.dataset.filtered = String(state.group !== 'all');
        for (const button of trackLegend.querySelectorAll('button[data-track]')) {
          button.setAttribute('aria-pressed', String(button.dataset.track === state.group));
        }
      }

      function syncEdgeCount() {
        const total = state.edges.length;
        const backbone = state.edges.filter((edge) => edge.backbone).length;
        edgeCount.textContent = state.showAllEdges ? `All ${total} links` : `${backbone} of ${total} links`;
        edgeCount.title = state.showAllEdges ? 'Show only the strongest links' : 'Show every link, including weak ones';
        edgeCount.setAttribute('aria-pressed', String(state.showAllEdges));
      }

      function renderSearchResults() {
        if (!state.query) {
          state.matches = [];
          searchResults.hidden = true;
          return;
        }
        const inTitle = (node) => node.title.toLowerCase().includes(state.query);
        state.matches = state.nodes
          .filter(matchesFilters)
          .sort(
            (a, b) =>
              Number(inTitle(b)) - Number(inTitle(a)) ||
              (b.weightedDegree || b.degree || 0) - (a.weightedDegree || a.degree || 0),
          );
        const shown = state.matches.slice(0, 6);
        searchResults.innerHTML = shown.length
          ? shown
              .map(
                (node) =>
                  `<button type="button" data-id="${escapeHtml(node.id)}">${nodeDot(node)}${escapeHtml(shortTitle(node.title))}<small>${escapeHtml(node.kind === 'concept' ? 'Concept' : trackLabel(node.track))}</small></button>`,
              )
              .join('') +
            (state.matches.length > shown.length
              ? `<span>${state.matches.length - shown.length} more match${state.matches.length - shown.length === 1 ? '' : 'es'} in the graph</span>`
              : '')
          : '<span>No matching nodes</span>';
        searchResults.hidden = false;
      }

      function clearSearch() {
        searchInput.value = '';
        state.query = '';
        state.matches = [];
        searchResults.hidden = true;
        applyFilters();
      }

      // Picking a result drops the text filter, so the node's neighbours are
      // not hidden by the query that found it.
      function pickSearchResult(node) {
        clearSearch();
        searchInput.blur();
        selectNode(node);
      }

      function nodeDot(node) {
        const color = node.kind === 'concept' ? conceptColor : node.color;
        return `<i class="dot" data-kind="${node.kind}" style="background:${color}"></i>`;
      }

      function trackLabel(key) {
        return state.tracks.find((track) => track.key === key)?.label || groupLabel(key);
      }

      function syncRotation() {
        controls.autoRotate = state.rotate && !state.hovered && !state.selected;
      }

      function syncUrl(node) {
        const url = new URL(window.location.href);
        if (node) url.searchParams.set('focus', node.route || node.id);
        else url.searchParams.delete('focus');
        window.history.replaceState(null, '', url);
      }

      function renderNeighbors() {
        const list = state.neighborsExpanded ? state.neighborList : state.neighborList.slice(0, neighborPreview);
        const hiddenCount = state.neighborList.length - list.length;
        neighbors.innerHTML =
          list
            .map(
              (node) =>
                `<button type="button" data-id="${escapeHtml(node.id)}">${nodeDot(node)}${escapeHtml(shortTitle(node.title))}</button>`,
            )
            .join('') +
          (hiddenCount > 0 ? `<button class="more" type="button" data-more="true">+${hiddenCount} more</button>` : '');
      }

      function selectNode(node) {
        const previousHighlight = graphGroup.getObjectByName('edges-highlight');
        if (previousHighlight) {
          graphGroup.remove(previousHighlight);
          previousHighlight.geometry.dispose();
          previousHighlight.material.dispose();
        }

        state.selected = node;
        state.neighborIds = new Set();
        state.neighborList = [];
        state.neighborsExpanded = false;
        details.dataset.open = String(Boolean(node));
        detailsClose.hidden = !node;
        selectionRing.visible = Boolean(node);
        syncRotation();
        syncUrl(node);

        if (!node) {
          state.focusPoint = null;
          state.focusDistance = null;
          applyFilters();
          detailTitle.textContent = 'Knowledge Graph';
          detailCopy.textContent = 'Click a node to see what it connects to, or a track to isolate it.';
          detailMeta.innerHTML = '';
          neighbors.innerHTML = '';
          openLink.dataset.visible = 'false';
          return;
        }

        const touching = state.edges
          .filter((edge) => edge.source.id === node.id || edge.target.id === node.id)
          .sort((a, b) => b.weight - a.weight);
        for (const edge of touching) {
          const other = edge.source.id === node.id ? edge.target : edge.source;
          if (state.neighborIds.has(other.id)) continue;
          state.neighborIds.add(other.id);
          state.neighborList.push(other);
        }

        selectionRing.position.set(node.x, node.y, node.z);
        selectionRing.scale.setScalar(nodeRadius(node) * 3.6);
        renderHighlightEdges(node);
        applyFilters();

        // Fly to the node and stop at a distance that keeps most of its
        // neighbours in frame.
        state.focusPoint = new THREE.Vector3(node.x, node.y, node.z);
        const reach = state.neighborList
          .map((other) => Math.hypot(other.x - node.x, other.y - node.y, other.z - node.z))
          .sort((a, b) => a - b);
        const spread = reach[Math.floor(reach.length * 0.75)] || 120;
        state.focusDistance = THREE.MathUtils.clamp(spread * 2.1, 260, 640);

        detailTitle.textContent = node.title;
        detailCopy.textContent = node.description || trackLabel(node.track);
        detailMeta.innerHTML = [
          node.kind === 'concept' ? 'Concept' : 'Document',
          trackLabel(node.track),
          `${state.neighborList.length} connections`,
        ]
          .filter(Boolean)
          .map((item) => `<span>${escapeHtml(item)}</span>`)
          .join('');
        if (node.kind === 'doc' && node.route) {
          openLink.href = node.route;
          openLink.dataset.visible = 'true';
        } else {
          openLink.dataset.visible = 'false';
        }
        renderNeighbors();
      }

      function renderHighlightEdges(node) {
        const touching = state.edges.filter(
          (edge) => edge.source.id === node.id || edge.target.id === node.id,
        );
        if (!touching.length) return;

        const positions = new Float32Array(touching.length * 6);
        const colors = new Float32Array(touching.length * 6);
        const color = new THREE.Color();
        touching.forEach((edge, index) => {
          const offset = index * 6;
          positions.set(
            [edge.source.x, edge.source.y, edge.source.z, edge.target.x, edge.target.y, edge.target.z],
            offset,
          );
          color.set(edgeColor(edge.type)).multiplyScalar(1.3);
          colors.set([color.r, color.g, color.b, color.r, color.g, color.b], offset);
        });

        const geometry = new THREE.BufferGeometry();
        geometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
        geometry.setAttribute('color', new THREE.BufferAttribute(colors, 3));
        const lines = new THREE.LineSegments(
          geometry,
          new THREE.LineBasicMaterial({
            vertexColors: true,
            transparent: true,
            opacity: 0.85,
            depthWrite: false,
            blending: THREE.AdditiveBlending,
          }),
        );
        lines.name = 'edges-highlight';
        graphGroup.add(lines);
      }

      function setHovered(node) {
        if (node?.id === state.hovered?.id) return;
        if (state.hovered) {
          const previous = state.nodeObjects.get(state.hovered.id);
          if (previous) previous.scale.copy(previous.userData.baseScale);
        }
        state.hovered = node;
        if (node) {
          const mesh = state.nodeObjects.get(node.id);
          if (mesh) mesh.scale.copy(mesh.userData.baseScale).multiplyScalar(1.22);
        }
        // A still target is easier to click than a rotating one.
        syncRotation();
        renderer.domElement.style.cursor = node ? 'pointer' : 'grab';
      }

      function updateHover() {
        if (!pointerDirty) return;
        pointerDirty = false;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects(
          nodeGroup.children.filter((mesh) => mesh.visible),
          false,
        );
        setHovered(hits[0]?.object?.userData?.node || null);
      }

      function onCanvasClick(event) {
        if (pointerMoved) return;
        const rect = renderer.domElement.getBoundingClientRect();
        pointer.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
        pointer.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
        raycaster.setFromCamera(pointer, camera);
        const hits = raycaster.intersectObjects([...state.nodeObjects.values()].filter((mesh) => mesh.visible), false);
        selectNode(hits[0]?.object?.userData?.node || null);
      }

      function resize() {
        const width = window.innerWidth;
        const height = window.innerHeight;
        camera.aspect = width / Math.max(height, 1);
        camera.updateProjectionMatrix();
        renderer.setSize(width, height, false);
        composer?.setSize(width, height);
      }

      function focusFromQuery() {
        const focus = new URLSearchParams(window.location.search).get('focus');
        if (!focus) return;
        const target =
          state.nodes.find((node) => node.route === focus) ||
          state.nodes.find((node) => node.id === focus);
        if (!target) return;
        selectNode(target);
      }

      function resetCamera() {
        state.focusPoint = null;
        state.focusDistance = null;
        controls.target.set(0, 0, 0);
        camera.position.set(0, homeDistance() * 0.16, homeDistance());
        scene.fog.density = 0.9 / homeDistance();
        controls.update();
      }

      function animate() {
        if (state.focusPoint) {
          // Move the camera with the target so the viewing angle stays put.
          cameraOffset.copy(controls.target);
          controls.target.lerp(state.focusPoint, 0.08);
          camera.position.add(cameraOffset.subVectors(controls.target, cameraOffset));
          if (state.focusDistance) {
            cameraOffset.copy(camera.position).sub(controls.target);
            const current = Math.max(cameraOffset.length(), 1);
            const next = current + (state.focusDistance - current) * 0.07;
            camera.position.copy(controls.target).add(cameraOffset.multiplyScalar(next / current));
            if (Math.abs(next - state.focusDistance) < 1) state.focusDistance = null;
          }
          if (!state.focusDistance && controls.target.distanceTo(state.focusPoint) < 0.5) state.focusPoint = null;
        }
        controls.update();
        updateHover();
        updateLabels();
        if (composer) composer.render();
        else renderer.render(scene, camera);
        window.requestAnimationFrame(animate);
      }

      function fibonacciPoint(index, total, radius) {
        const offset = 2 / Math.max(total, 1);
        const increment = Math.PI * (3 - Math.sqrt(5));
        const y = index * offset - 1 + offset / 2;
        const r = Math.sqrt(1 - y * y);
        const phi = index * increment;
        return {
          x: Math.cos(phi) * r * radius,
          y: y * radius,
          z: Math.sin(phi) * r * radius,
        };
      }

      function nodeRadius(node) {
        const base = node.kind === 'concept' ? 5.5 : 3.2;
        return Math.min(node.kind === 'concept' ? 13 : 9, base + Math.sqrt(node.weightedDegree || node.degree || 1) * 1.0);
      }

      function edgeColor(type) {
        if (type.includes('mentions')) return token('viz-4', '#cf9be0');
        if (type.includes('link')) return token('accent', '#70c5d0');
        if (type.includes('semantic')) return token('viz-7', '#94aaa8');
        if (type.includes('section')) return token('viz-5', '#d8cf89');
        return token('text-subtle', '#8d94a8');
      }

      function shortTitle(title) {
        const cleaned = String(title)
          .replace(/^chapter\s+\d+:\s*/i, '')
          .replace(/^week\s+\d+:\s*/i, '')
          .replace(/\s+/g, ' ')
          .trim();
        const words = cleaned.split(/\s+/).filter(Boolean);
        return words.slice(0, 5).join(' ').slice(0, 42);
      }

      function groupLabel(group) {
        return String(group || '')
          .split('-')
          .filter(Boolean)
          .map((part) => {
            const upper = part.toUpperCase();
            if (['AI', 'GPU', 'LLM', 'CME'].includes(upper)) return upper;
            return part.charAt(0).toUpperCase() + part.slice(1);
          })
          .join(' ');
      }

      function showStatus(title, message) {
        status.hidden = false;
        status.innerHTML = `<div class="status-box"><strong>${escapeHtml(title)}</strong><span>${escapeHtml(message)}</span></div>`;
      }

      function escapeHtml(value) {
        return String(value ?? '').replace(/[&<>"']/g, (char) => {
          const entities = {
            '&': '&amp;',
            '<': '&lt;',
            '>': '&gt;',
            '"': '&quot;',
            "'": '&#39;',
          };
          return entities[char];
        });
      }
    </script>
  </body>
</html>
